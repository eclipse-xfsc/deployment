#cloud-config

package_update: true

packages:
  - curl
  - ca-certificates

write_files:
  - path: /etc/netplan/60-private-network.yaml
    owner: root:root
    permissions: "0600"
    content: |
      network:
        version: 2
        renderer: networkd
        ethernets:
          enp7s0:
            dhcp4: true
            dhcp6: false
            optional: true

  - path: /usr/local/sbin/install-k3s-worker.sh
    owner: root:root
    permissions: "0750"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      exec > >(tee -a /var/log/install-k3s-worker.log) 2>&1

      export K3S_TOKEN="${cluster_token}"

%{ if k3s_version != "" ~}
      export INSTALL_K3S_VERSION="${k3s_version}"
%{ endif ~}

      NODE_IP="${node_ip}"
      FIRST_SERVER_IP="${first_server_ip}"
      NODE_NAME="${node_name}"

      echo "Applying private network configuration..."

      netplan generate
      netplan apply

      echo "Waiting for private IP $${NODE_IP}..."

      PRIVATE_IP_READY=false

      for attempt in $(seq 1 300); do
        if ip -4 -o addr show |
          awk '{split($4, address, "/"); print address[1]}' |
          grep -Fxq "$${NODE_IP}"; then
          PRIVATE_IP_READY=true
          break
        fi

        echo "Waiting for private IP $${NODE_IP}... ($${attempt}/300)"
        sleep 2
      done

      if [ "$${PRIVATE_IP_READY}" != "true" ]; then
        echo "Timed out waiting for private IP $${NODE_IP}." >&2
        ip -br addr >&2
        ip route >&2
        networkctl list >&2 || true
        netplan status --all >&2 || true
        exit 1
      fi

      PRIVATE_INTERFACE="$(
        ip -4 -o addr show |
          awk -v ip="$${NODE_IP}" '
            {
              split($4, address, "/")
              if (address[1] == ip) {
                print $2
                exit
              }
            }
          '
      )"

      if [ -z "$${PRIVATE_INTERFACE}" ]; then
        echo "Unable to determine private network interface for $${NODE_IP}." >&2
        ip -br addr >&2
        exit 1
      fi

      echo "Using private interface: $${PRIVATE_INTERFACE}"
      echo "Waiting for K3s server at $${FIRST_SERVER_IP}:6443..."

      SERVER_READY=false

      for attempt in $(seq 1 450); do
        if timeout 2 bash -c \
          "</dev/tcp/$${FIRST_SERVER_IP}/6443" 2>/dev/null; then
          SERVER_READY=true
          break
        fi

        echo "Waiting for K3s server at $${FIRST_SERVER_IP}:6443... ($${attempt}/450)"
        sleep 2
      done

      if [ "$${SERVER_READY}" != "true" ]; then
        echo "Timed out waiting for K3s server at $${FIRST_SERVER_IP}:6443." >&2
        ip -br addr >&2
        ip route >&2
        exit 1
      fi

      K3S_ARGS=(
        agent
        --server "https://$${FIRST_SERVER_IP}:6443"
        --node-name "$${NODE_NAME}"
        --node-ip "$${NODE_IP}"
        --flannel-iface "$${PRIVATE_INTERFACE}"
      )

      if systemctl list-unit-files --no-legend |
        grep -q '^k3s-agent.service'; then
        echo "K3s agent is already installed."
        systemctl enable k3s-agent
        systemctl restart k3s-agent
      else
        echo "Installing K3s worker node $${NODE_NAME}..."
        printf 'K3s argument: %q\n' "$${K3S_ARGS[@]}"

        curl \
          --fail \
          --silent \
          --show-error \
          --location \
          --retry 10 \
          --retry-all-errors \
          --retry-delay 3 \
          --connect-timeout 10 \
          --max-time 300 \
          https://get.k3s.io |
          sh -s - "$${K3S_ARGS[@]}"
      fi

      echo "Waiting for K3s agent service..."

      for attempt in $(seq 1 60); do
        if systemctl is-active --quiet k3s-agent; then
          echo "K3s worker installation completed."
          exit 0
        fi

        sleep 2
      done

      echo "K3s agent did not become active." >&2
      systemctl status k3s-agent --no-pager >&2 || true
      journalctl -u k3s-agent -n 200 --no-pager >&2 || true
      exit 1

runcmd:
  - [bash, /usr/local/sbin/install-k3s-worker.sh]

final_message: "Worker bootstrap completed after $UPTIME seconds."