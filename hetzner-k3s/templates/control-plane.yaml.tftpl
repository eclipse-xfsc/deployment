#cloud-config
package_update: true

packages:
  - curl
  - jq
  - ca-certificates

write_files:
  - path: /usr/local/sbin/install-k3s-control-plane.sh
    owner: root:root
    permissions: "0750"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      export K3S_TOKEN="${cluster_token}"

%{ if k3s_version != "" ~}
      export INSTALL_K3S_VERSION="${k3s_version}"
%{ endif ~}

      NODE_NAME="${node_name}"
      NODE_IP="${node_ip}"
      FIRST_SERVER_IP="${first_server_ip}"
      API_TLS_SAN="${api_tls_san}"

      echo "Waiting for private IP $${NODE_IP}..."

      until ip -4 -o addr show |
        awk '{print $4}' |
        cut -d/ -f1 |
        grep -Fxq "$${NODE_IP}"; do
        sleep 2
      done

      PRIVATE_INTERFACE="$(
        ip -4 -o addr show |
          awk -v ip="$${NODE_IP}" '
            {
              split($4, address, "/")
              if (address[1] == ip) {
                print $2
                exit
              }
            }
          '
      )"

      if [[ -z "$${PRIVATE_INTERFACE}" ]]; then
        echo "Unable to determine private network interface for $${NODE_IP}." >&2
        exit 1
      fi

      echo "Using private interface: $${PRIVATE_INTERFACE}"

      K3S_ARGS=(
        server
        --node-name "$${NODE_NAME}"
        --node-ip "$${NODE_IP}"
        --advertise-address "$${NODE_IP}"
        --flannel-iface "$${PRIVATE_INTERFACE}"
        --write-kubeconfig-mode "0600"
      )

%{ if cluster_init ~}
      K3S_ARGS+=(
        --cluster-init
      )
%{ else ~}
      echo "Waiting for first K3s server at $${FIRST_SERVER_IP}:6443..."

      until timeout 2 bash -c "</dev/tcp/$${FIRST_SERVER_IP}/6443" 2>/dev/null; do
        sleep 5
      done

      K3S_ARGS+=(
        --server "https://$${FIRST_SERVER_IP}:6443"
      )
%{ endif ~}

      if [[ -n "$${API_TLS_SAN}" ]]; then
        echo "Adding Kubernetes API TLS SAN: $${API_TLS_SAN}"

        K3S_ARGS+=(
          --tls-san "$${API_TLS_SAN}"
        )
      else
        echo "WARNING: No Kubernetes API TLS SAN configured." >&2
      fi

%{ if disable_flags != "" ~}
      read -r -a DISABLE_ARGS <<< "${disable_flags}"
      K3S_ARGS+=(
        "$${DISABLE_ARGS[@]}"
      )
%{ endif ~}

      echo "Installing K3s control-plane node $${NODE_NAME}..."
      printf 'K3s argument: %q\n' "$${K3S_ARGS[@]}"

      curl \
        --fail \
        --silent \
        --show-error \
        --location \
        --retry 5 \
        --retry-delay 3 \
        https://get.k3s.io |
        sh -s - "$${K3S_ARGS[@]}"

      systemctl enable k3s
      systemctl restart k3s

      echo "Waiting for local Kubernetes API..."

      until timeout 2 bash -c "</dev/tcp/127.0.0.1/6443" 2>/dev/null; do
        sleep 5
      done

      echo "K3s control-plane installation completed."

runcmd:
  - [bash, /usr/local/sbin/install-k3s-control-plane.sh]