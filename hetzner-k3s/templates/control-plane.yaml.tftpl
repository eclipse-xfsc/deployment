#cloud-config
package_update: true

packages:
  - curl
  - jq
  - ca-certificates

write_files:
  - path: /etc/netplan/60-private-network.yaml
    owner: root:root
    permissions: "0600"
    content: |
      network:
        version: 2
        renderer: networkd
        ethernets:
          enp7s0:
            dhcp4: true
            dhcp6: false
            optional: true

  - path: /usr/local/sbin/install-k3s-control-plane.sh
    owner: root:root
    permissions: "0750"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      export K3S_TOKEN="${cluster_token}"

%{ if k3s_version != "" ~}
      export INSTALL_K3S_VERSION="${k3s_version}"
%{ endif ~}

      NODE_NAME="${node_name}"
      NODE_IP="${node_ip}"
      FIRST_SERVER_IP="${first_server_ip}"
      API_TLS_SAN="${api_tls_san}"

      echo "Waiting for private IP $${NODE_IP}..."

      private_ip_ready=false

      for attempt in $(seq 1 60); do
        if ip -4 -o addr show |
          awk '{print $4}' |
          cut -d/ -f1 |
          grep -Fxq "$${NODE_IP}"
        then
          private_ip_ready=true
          break
        fi

        echo "Waiting for private IP $${NODE_IP}... ($${attempt}/60)"
        ip -br addr
        sleep 2
      done

      if [[ "$${private_ip_ready}" != "true" ]]; then
        echo "Private IP $${NODE_IP} was not assigned." >&2
        ip -br addr >&2
        networkctl list >&2 || true
        exit 1
      fi

      PRIVATE_INTERFACE="$(
        ip -4 -o addr show |
          awk -v ip="$${NODE_IP}" '
            {
              split($4, address, "/")
              if (address[1] == ip) {
                print $2
                exit
              }
            }
          '
      )"

      if [[ -z "$${PRIVATE_INTERFACE}" ]]; then
        echo "Unable to determine private interface for $${NODE_IP}." >&2
        exit 1
      fi

      echo "Using private interface: $${PRIVATE_INTERFACE}"

      K3S_ARGS=(
        server
        --node-name "$${NODE_NAME}"
        --node-ip "$${NODE_IP}"
        --advertise-address "$${NODE_IP}"
        --flannel-iface "$${PRIVATE_INTERFACE}"
        --write-kubeconfig-mode "0600"
        --disable-cloud-controller
        --kubelet-arg "cloud-provider=external"
      )

%{ if cluster_init ~}
      K3S_ARGS+=(--cluster-init)
%{ else ~}
      first_server_ready=false

      for attempt in $(seq 1 60); do
        if timeout 3 bash -c \
          "</dev/tcp/$${FIRST_SERVER_IP}/6443" 2>/dev/null
        then
          first_server_ready=true
          break
        fi

        echo "Waiting for first K3s server at $${FIRST_SERVER_IP}:6443... ($${attempt}/60)"
        sleep 5
      done

      if [[ "$${first_server_ready}" != "true" ]]; then
        echo "First K3s server did not become reachable." >&2
        exit 1
      fi

      K3S_ARGS+=(
        --server "https://$${FIRST_SERVER_IP}:6443"
      )
%{ endif ~}

      if [[ -n "$${API_TLS_SAN}" ]]; then
        K3S_ARGS+=(
          --tls-san "$${API_TLS_SAN}"
        )
      else
        echo "WARNING: No Kubernetes API TLS SAN configured." >&2
      fi

%{ if disable_flags != "" ~}
      read -r -a DISABLE_ARGS <<< "${disable_flags}"
      K3S_ARGS+=("$${DISABLE_ARGS[@]}")
%{ endif ~}

      echo "Installing K3s control-plane node $${NODE_NAME}..."
      printf 'K3s argument: %q\n' "$${K3S_ARGS[@]}"

      curl \
        --fail \
        --silent \
        --show-error \
        --location \
        --retry 5 \
        --retry-delay 3 \
        https://get.k3s.io |
        sh -s - "$${K3S_ARGS[@]}"

      local_api_ready=false

      for attempt in $(seq 1 60); do
        if timeout 3 bash -c '</dev/tcp/127.0.0.1/6443' 2>/dev/null; then
          local_api_ready=true
          break
        fi

        echo "Waiting for local Kubernetes API... ($${attempt}/60)"
        sleep 5
      done

      if [[ "$${local_api_ready}" != "true" ]]; then
        echo "Local Kubernetes API did not become ready." >&2
        systemctl status k3s --no-pager >&2 || true
        journalctl -u k3s -n 100 --no-pager >&2 || true
        exit 1
      fi

      echo "K3s control-plane installation completed."

runcmd:
  - [netplan, generate]
  - [netplan, apply]
  - [bash, /usr/local/sbin/install-k3s-control-plane.sh]