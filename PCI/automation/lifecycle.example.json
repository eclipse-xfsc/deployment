{
  "g0Args": [
    "--kubeconfig",
    "/private/kubeconfig.yaml",
    "--context",
    "YOUR-CONTEXT",
    "--orce-namespace",
    "xfsc-orce-pci-orce",
    "--orce-deployment",
    "xfsc-orce",
    "--orce-container",
    "orce",
    "--orce-service",
    "xfsc-orce-service-pci-orce",
    "--orce-service-port",
    "80",
    "--orce-base-path",
    "/pci-orce",
    "--orce-editor-path",
    "/pci-orce",
    "--main-host",
    "pci.example.com",
    "--cert",
    "/private/fullchain.pem",
    "--key",
    "/private/privkey.pem",
    "--provider-email",
    "provider@example.com",
    "--ocm-namespace",
    "ocm-wstack",
    "--keycloak-service-name",
    "ocm-ui-keycloak",
    "--keycloak-internal-url",
    "http://ocm-ui-keycloak.ocm-wstack.svc.cluster.local:8080/orce/identity",
    "--infrastructure-namespace",
    "infrastructure",
    "--envoy-namespace",
    "infrastructure",
    "--gateway-class-name",
    "envoy",
    "--gateway-name",
    "pci-gateway",
    "--orce-data-storage-class",
    "ionos-cloud-essential",
    "--postgres-storage-class",
    "ionos-cloud-essential",
    "--mail-mode",
    "mailpit"
  ],
  "editorUrl": "https://pci.example.com/pci-orce",
  "editorUsername": "admin",
  "editorPasswordFile": "/private/editor-password",
  "environment": {
    "PCI_OBSERVABILITY_MODE": "managed"
  },
  "allowUninstall": false
}
